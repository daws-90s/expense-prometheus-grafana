domain_name     = "daws90s.shop"
route53_zone_id = "Z07086101C1CVP7AT2UK4"

# 0.0.0.0/0 keeps the values this repo was already applying with -- narrow
# both to your own IP (e.g. "1.2.3.4/32") before leaving this running.
ssh_cidr     = "0.0.0.0/0"
browser_cidr = "0.0.0.0/0"

# TODO: these are placeholders, not real credentials -- Alertmanager will
# fail to start until you replace them with a real SMTP smarthost/app
# password and a real Slack incoming-webhook URL. See
# terraform.tfvars.example for where to get each one.
alertmanager_smtp_host          = "smtp.gmail.com:587"
alertmanager_smtp_from          = "your-from-email"
alertmanager_smtp_auth_username = "your-from-email"
alertmanager_smtp_auth_password = "your-app-password"
alertmanager_email_to           = "your-to-email"
alertmanager_slack_webhook_url  = "slack-incoming-webhook-url"
alertmanager_slack_channel      = "#channel-name"
